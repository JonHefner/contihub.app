NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Canonical production origin. Apex (https://contihub.app) is rewritten to www.
NEXT_PUBLIC_SITE_URL=https://www.contihub.app

# Server-only. Mints Supabase magic links for bid invites and staff invites.
# Never expose this to the browser. Leave blank until it is set in Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Conti mailbox that should send bid invitations once Graph is connected.
# Preferred for Jon: jon.hefner@continentalcando.com
# This is configuration, not a secret. The Graph client secret is the secret.
CONTI_BID_FROM_MAILBOX=

# Optional Microsoft Graph application credentials (Mail.Send, admin consent).
# Without all four values, Conti Bid keeps the invitee row and magic link,
# then copies a draft / opens mailto. It does not call Graph.
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
